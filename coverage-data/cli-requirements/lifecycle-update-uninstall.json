    {
      "id": "cli.update.user.latest",
      "interface": "cli",
      "profile": "user",
      "category": "lifecycle",
      "description": "Updating a user application when version B is the branch tip succeeds, makes B the installed commit, and runs B's contents.",
      "sources": [
        {
          "path": "doc/flatpak-update.xml",
          "anchor": "Normally, this command updates the application to the tip of its branch."
        }
      ],
      "surfaces": [
        "cli.command.update"
      ],
      "required_capabilities": [
        "cli",
        "user-installation",
        "local-repository",
        "sandbox-execution"
      ]
    },
    {
      "id": "cli.update.user.failed-download-preserves",
      "interface": "cli",
      "profile": "user",
      "category": "lifecycle",
      "description": "An update whose required application payload cannot be downloaded fails and leaves the previously installed application A and its runtime at their prior commits, with A still runnable.",
      "sources": [
        {
          "path": "doc/flatpak-update.xml",
          "anchor": "Description"
        }
      ],
      "surfaces": [
        "cli.command.update"
      ],
      "required_capabilities": [
        "cli",
        "user-installation",
        "local-repository",
        "sandbox-execution",
        "network-fault-injection"
      ]
    },
