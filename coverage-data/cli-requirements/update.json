      ]
    },
    {
      "id": "cli.update.user.retry",
      "interface": "cli",
      "profile": "user",
      "category": "lifecycle",
      "description": "After a required payload download failure, retrying the user update once the source is available succeeds in fetching the needed data and installs runnable version B with the expected app/runtime commits.",
      "sources": [
        {
          "path": "doc/flatpak-update.xml",
          "anchor": "Description"
        }
