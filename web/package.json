{
  "name": "flatpak-coverage",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.ts",
    "check": "tsc --noEmit && prettier --check . ../ci/baselines.json",
    "format": "prettier --write . ../ci/baselines.json",
    "test": "tsx --test test/*.test.ts",
    "history": "tsx scripts/history.ts",
    "baseline": "tsx scripts/baseline.ts",
    "matrix": "node scripts/matrix.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/charts": "1.1.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
