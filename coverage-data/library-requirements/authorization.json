      "id": "library.authorization.system.no-interaction",
      "interface": "library",
      "profile": "system",
      "category": "authorization",
      "description": "Setting installation no_interaction TRUE is reflected by its getter and prevents interactive authorization dialogs during a system operation that would otherwise request authorization. Lack of authorization still produces failure rather than success.",
