{
  "name": "flatpak-coverage",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "tsx --test test/*.test.ts",
    "history": "tsx scripts/history.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tanstack/charts": "0.18.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
